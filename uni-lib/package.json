{
  "name": "uni-ui-lib",
  "version": "0.1.28",
  "description": "Vue 3 + Element Plus business component library for admin systems.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/src/index.d.ts",
  "style": "dist/index.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./dist/index.css": "./dist/index.css",
    "./*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./components/*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./components/*/style.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./utils/*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plugins/*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./directives/*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./composables/*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./locales/*": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,md}\" \"docs/**/*.md\" \"docs/.vitepress/**/*.{ts,vue,css}\" \"playground/**/*.{ts,vue,scss,md,json}\" \"scripts/**/*.{ts,js,mjs,md}\" \"*.{json,ts,mjs,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,md}\" \"docs/**/*.md\" \"docs/.vitepress/**/*.{ts,vue,css}\" \"playground/**/*.{ts,vue,scss,md,json}\" \"scripts/**/*.{ts,js,mjs,md}\" \"*.{json,ts,mjs,md}\"",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "components",
    "admin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@element-plus/icons-vue": "latest",
    "axios": "latest",
    "element-plus": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-i18n": "latest",
    "vue-router": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "prettier": "latest",
    "sass": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vitepress": "latest",
    "vue-tsc": "latest"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": ">=2.0.0",
    "axios": ">=1.0.0",
    "element-plus": ">=2.0.0",
    "pinia": ">=2.0.0",
    "vue": ">=3.5.0",
    "vue-i18n": ">=11.0.0",
    "vue-router": ">=4.0.0"
  }
}
