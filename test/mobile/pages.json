{
	"easycom": {
		"^u-(.*)": "@/uview-ui/components/u-$1/u-$1.vue"
	},
	"pages": [
		//pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/tabbar/index",
			"style": {
				"navigationBarTitleText": "星乐度",
				"enablePullDownRefresh": false,
				"titleNView": false,
				"app-plus": {
					"bounce": "none"
				}
			}
		},
		{
			"path": "pages/view/web-view",
			"style": {
				"navigationBarTitleText": "详情",
				"enablePullDownRefresh": false, // 不开启下拉刷新, 默认就是false
				"app-plus": {
					"bounce": "none" // 取消iOS回弹,避免和下拉刷新冲突 (小程序无法取消, 点此查看H5端的取消方法... )
				}
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"enablePullDownRefresh": false, // 不开启下拉刷新, 默认就是false
				"titleNView": false,
				"app-plus": {
					"bounce": "none" // 取消iOS回弹,避免和下拉刷新冲突 (小程序无法取消, 点此查看H5端的取消方法... )
				}
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "丰云行",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#f33e54"
	},
	"condition": { //模式配置，仅开发期间生效
	    "current": 0, //当前激活的模式（list 的索引项）
	    "list": [{
	            "name": "home", //模式名称
	            "path": "pages/tabbar/index", //启动页面，必选
	            "query": "curIndex=news" //启动参数，在页面的onLoad函数里面得到。
	        },
	        {
	            "name": "login",
	            "path": "pages/login/login"
	        }
	    ]
	}
}
