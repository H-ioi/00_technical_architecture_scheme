{
  "name": "admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"*.{ts,mjs,cjs}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"*.{ts,mjs,cjs}\" --fix",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\" --allow-empty-input",
    "lint:style:fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix --allow-empty-input",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,md,json}\" \"*.{json,ts,mjs,cjs,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,md,json}\" \"*.{json,ts,mjs,cjs,md}\"",
    "type-check": "vue-tsc --noEmit",
    "locale:dup-scan": "node scripts/scan-locale-duplicate-values.mjs --all",
    "extract:legacy-isacommunity-base": "node scripts/extract-isacommunity-base-api.mjs",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/crypto-js": "^4.2.2",
    "@vue/devtools-api": "^7.7.9",
    "aieditor": "^1.4.2",
    "axios": "^1.15.2",
    "bpmn-js": "^6.0.4",
    "bpmn-js-properties-panel": "^0.33.0",
    "camunda-bpmn-moddle": "^4.3.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "echarts": "^5.6.0",
    "element-plus": "^2.13.7",
    "pinia": "^3.0.4",
    "sass": "^1.99.0",
    "uni-ui-lib": "latest",
    "vue": "^3.5.12",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  }
}
